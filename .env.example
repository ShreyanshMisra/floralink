# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key

# Supabase Server
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Product
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_REGION=US-MA

# Maps
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
NEXT_PUBLIC_MAP_DEFAULT_LAT=42.3601
NEXT_PUBLIC_MAP_DEFAULT_LNG=-71.0589
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=8

# iNaturalist
INATURALIST_BASE_URL=https://api.inaturalist.org/v1
EXTERNAL_API_TIMEOUT_MS=5000
INATURALIST_CACHE_TTL_SECONDS=86400